// ===============================================================================
// NBA SPATIAL EFFICIENCY & EXPECTED VALUE (EV) - POWER BI DAX MEASURES
// Format: Paste these measures into your Power BI Model
// ===============================================================================

// -------------------------------------------------------------------------------
// 1. VOLUME & SCORING METRICS
// -------------------------------------------------------------------------------

Total Shots = 
COUNT(Fact_Shots[SHOT_ID])

Total Makes = 
SUM(Fact_Shots[SHOT_MADE_FLAG])

Total Misses = 
[Total Shots] - [Total Makes]

Total Points = 
SUM(Fact_Shots[POINTS_SCORED])

// -------------------------------------------------------------------------------
// 2. SHOOTING EFFICIENCY MEASURES
// -------------------------------------------------------------------------------

Field Goal % = 
DIVIDE([Total Makes], [Total Shots], 0)

3PT Makes = 
CALCULATE([Total Makes], Fact_Shots[SHOT_VALUE] = 3)

3PT Attempts = 
CALCULATE([Total Shots], Fact_Shots[SHOT_VALUE] = 3)

3PT % = 
DIVIDE([3PT Makes], [3PT Attempts], 0)

Effective FG% = 
DIVIDE([Total Makes] + 0.5 * [3PT Makes], [Total Shots], 0)

// -------------------------------------------------------------------------------
// 3. EXPECTED VALUE (EV) & POINTS ABOVE EXPECTED (PAE) METRICS
// -------------------------------------------------------------------------------

Expected Points = 
SUM(Fact_Shots[EXPECTED_VALUE])

Points Above Expected = 
[Total Points] - [Expected Points]

PAE Per Shot = 
DIVIDE([Points Above Expected], [Total Shots], 0)

Expected Value Per Shot = 
DIVIDE([Expected Points], [Total Shots], 0)

Actual Points Per Shot = 
DIVIDE([Total Points], [Total Shots], 0)

Shot Efficiency Index = 
DIVIDE([Actual Points Per Shot], [Expected Value Per Shot], 1)

// -------------------------------------------------------------------------------
// 4. SPATIAL ZONE DIFFERENTIALS
// -------------------------------------------------------------------------------

Zone Baseline FG% = 
AVERAGE(Fact_Shots[ZONE_BASELINE_FG_PCT])

Zone Performance Diff = 
[Field Goal %] - [Zone Baseline FG%]
